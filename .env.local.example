# TechVault — environment template.
# Copy to `.env.local` and fill in. NEVER commit `.env.local` (see CLAUDE.md §18.1).
# Every variable here is validated at boot by platform/config/env.ts — a missing
# required variable is a hard failure, not a warning.

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# ---------------------------------------------------------------------------
# Pooled connection used by the application at runtime.
DATABASE_URL=
# Direct (non-pooled) connection. Prisma 7's config reads only DATABASE_URL, so
# when running migrations against a pooled Supabase connection, run them with
# DATABASE_URL temporarily set to this value:
#   DATABASE_URL="$DIRECT_URL" npm run db:migrate
DIRECT_URL=

# ---------------------------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. If this ever reaches a client
# bundle, treat it as an incident and rotate the key.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute base URL, used for auth redirects and absolute links.
APP_URL=http://localhost:3000
# one of: development | preview | production
APP_ENV=development
# Object storage bucket for ECM document binaries (Phase 3).
STORAGE_BUCKET=techvault-documents
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Added in later phases — keep commented until the feature lands.
# ---------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# AI_LLM_PROVIDER=
# AI_LLM_API_KEY=
# AI_OCR_PROVIDER=
# AI_OCR_API_KEY=
