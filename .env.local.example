# TechVault — environment template.
# Copy to `.env.local` and fill in. NEVER commit `.env.local` (see CLAUDE.md §18.1).
# Every variable here is validated at boot by platform/config/env.ts — a missing
# required variable is a hard failure, not a warning.

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# ---------------------------------------------------------------------------
# Pooled connection used by the application at runtime. From the Supabase
# dashboard: Project Settings → Database → Connection string.
DATABASE_URL=

# Direct (non-pooled) connection, used for migrations.
#
# Prisma 7's config reads only DATABASE_URL, so DIRECT_URL is not wired in
# automatically. Run migrations with the direct connection substituted:
#   DATABASE_URL="$DIRECT_URL" npx prisma migrate dev
#
# Newer Supabase projects may not expose a direct IPv4 address. If
# db.<ref>.supabase.co does not resolve, use the SESSION pooler (port 5432) for
# migrations — not the transaction pooler on 6543, which does not support the
# prepared statements and DDL session state that migrations need.
DIRECT_URL=

# ---------------------------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=

# The browser-safe client key. Supabase's current format is `sb_publishable_…`;
# older projects issue a JWT "anon" key instead. Set whichever your project has —
# the publishable key wins if both are present.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL, and intentionally so: nothing in TechVault uses the privileged key
# today, and requiring a credential we do not need invites pasting the most
# dangerous secret in the project into every environment. Leave these empty until
# a change genuinely needs one, and never prefix either with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute base URL, used for auth redirects and absolute links.
APP_URL=http://localhost:3000
# one of: development | preview | production
APP_ENV=development
# Object storage bucket for ECM document binaries (Phase 3).
STORAGE_BUCKET=techvault-documents
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Integration tests (CLAUDE.md §20)
# ---------------------------------------------------------------------------
# Integration tests TRUNCATE tables. They run only when this is set, and it is a
# SEPARATE variable from DATABASE_URL on purpose: pointing them at a real database
# must be a deliberate act, never an accident of having a dev connection present.
# Use a dedicated local database — NEVER production, and never a database holding
# real data. A local Postgres is strongly preferred over a remote one: the suite
# is ~6x faster without internet round trips.
#   createdb techvault_test   (or CREATE DATABASE techvault_test)
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/techvault_test" npx prisma migrate deploy
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/techvault_test

# ---------------------------------------------------------------------------
# Added in later phases — keep commented until the feature lands.
# ---------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# AI_LLM_PROVIDER=
# AI_LLM_API_KEY=
# AI_OCR_PROVIDER=
# AI_OCR_API_KEY=
