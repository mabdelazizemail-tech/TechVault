// Platform — cross-cutting infrastructure tables.  Schema: "platform".
// Owned by platform/* services, never written directly by a domain module.

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL

  @@schema("platform")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  /// Exhausted its retries. Visible and alertable — never silently dropped (§10).
  DEAD

  @@schema("platform")
}

/// Append-only record of business- and security-significant operations
/// (CLAUDE.md §18.6). There is deliberately NO update or delete path: the
/// repository exposes insert and read only, and the database role the app uses
/// must not hold UPDATE or DELETE on this table.
model AuditLog {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  severity   AuditSeverity @default(INFO)

  /// The acting user, or null for system/scheduled activity (then actorLabel says what).
  actorId    String? @map("actor_id") @db.Uuid
  actorLabel String? @map("actor_label")

  /// Dotted action name, e.g. "iam.role.assigned", "ecm.document.downloaded".
  action     String
  module     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")

  /// Human-readable one-line summary, safe to display. Never put sensitive values here.
  summary String

  /// Changed fields only. Sensitive values are referenced, never copied (§18.5):
  /// record that `compensation.baseSalary` changed, not the amounts.
  changes Json?

  ipAddress     String? @map("ip_address")
  userAgent     String? @map("user_agent")
  correlationId String? @map("correlation_id")

  @@index([actorId, occurredAt])
  @@index([entityType, entityId])
  @@index([module, occurredAt])
  @@index([action, occurredAt])
  @@index([occurredAt])
  @@map("audit_log")
  @@schema("platform")
}

/// Transactional outbox (CLAUDE.md §10). A row is written in the SAME database
/// transaction as the business change, so an event can never describe a change
/// that rolled back.
///
/// Phase 1 writes to this table; the dispatcher and per-subscriber delivery
/// arrive in Phase 2. Until then events accumulate as a visible backlog —
/// which is a deliberate, inspectable state, not lost data.
model EventOutbox {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// "<module>.<Entity><PastTenseVerb>", e.g. "iam.RoleAssigned".
  name          String
  version       Int      @default(1)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorId       String?  @map("actor_id") @db.Uuid
  /// Entity IDs and the few fields subscribers need. NEVER sensitive data (§10).
  payload       Json
  correlationId String?  @map("correlation_id")

  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?      @map("last_error")
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@index([name, occurredAt])
  @@map("event_outbox")
  @@schema("platform")
}

/// In-app notifications (CLAUDE.md §7, ADR-036): one row per recipient, written by
/// `platform/notifications` inside the business transaction that caused it, so a
/// rolled-back change never notifies anyone and a committed one always does.
///
/// The text is a snapshot taken when the notification is written. `link` is an
/// application path, never a URL (a CHECK refuses anything else), and opening it
/// authorises again: a notification grants nothing.
///
/// Invariants Prisma cannot express — the CHECKs, the unread partial index and the
/// Realtime trigger that tells the recipient's browser a row arrived — are raw SQL
/// in the migration that creates this table.
model Notification {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String  @map("recipient_id") @db.Uuid
  /// Dotted kind, e.g. "committees.task.replied".
  type        String
  module      String
  entityType  String  @map("entity_type")
  entityId    String  @map("entity_id") @db.Uuid
  /// The record whose creation caused this notification — a task, a reply. With the
  /// recipient and type it is unique, so one event can never notify a person twice.
  sourceId    String  @map("source_id") @db.Uuid
  /// Who acted, or null for the system.
  actorId     String? @map("actor_id") @db.Uuid
  title       String
  body        String
  /// Application path such as "/committees/meetings/…", starting with one "/".
  link        String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Null while unread. A person may mark a notification unread again.
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([recipientId, type, sourceId])
  /// The bell and the notifications page: newest first, per person.
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId])
  @@map("notifications")
  @@schema("platform")
}

/// Runtime settings. Anything an administrator should be able to change without a
/// deploy lives here, not in code (CLAUDE.md §25.3).
model AppSetting {
  key         String   @id
  value       Json
  description String
  /// Settings safe to expose to a browser. Default false — opt in deliberately.
  isPublic    Boolean  @default(false) @map("is_public")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?  @map("updated_by") @db.Uuid

  @@map("app_settings")
  @@schema("platform")
}

/// Feature flags. Remove the flag once a rollout completes (§7).
model FeatureFlag {
  key         String   @id
  description String
  isEnabled   Boolean  @default(false) @map("is_enabled")
  /// Optional narrowing: enable for these org units only.
  orgUnitIds  String[] @map("org_unit_ids") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?  @map("updated_by") @db.Uuid

  @@map("feature_flags")
  @@schema("platform")
}
