// Committees — committee meetings, their agendas and their Team To-Do Lists.
// Owner: modules/committees.  Schema: "committees".
//
// Deliberately small (ADR-036): a committee has members; a meeting belongs to a
// committee and has an organiser and an ordered agenda; each meeting has a Team
// To-Do List of action items, each with responsible people and a discussion.
//
// A meeting's members are its committee's members — there is no separate
// attendee list. Who may see a meeting is decided by the services: members of its
// committee, its organiser, anyone responsible for one of its tasks, and committee
// administrators.
//
// A task's status is stored as Pending, In progress or Completed. "Overdue" is
// never stored: it is derived from the due date, so it cannot go stale.
//
// Invariants Prisma cannot express — CHECKs, live-row unique indexes, the
// append-only rule on replies and the reply counter trigger — are raw SQL in the
// migration that creates these tables.
//
// Models are prefixed `Committee` because Prisma model names share one namespace
// across every schema.

enum CommitteeTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED

  @@schema("committees")
}

model Committee {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  /// Archived committees keep their meetings and tasks but cannot schedule new ones.
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  members  CommitteeMember[]
  meetings CommitteeMeeting[]

  @@index([isActive, name])
  @@map("committees")
  @@schema("committees")
}

model CommitteeMember {
  committeeId String   @map("committee_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  user      User      @relation("CommitteeMemberUser", fields: [userId], references: [id], onDelete: Restrict)

  // The primary key serves "who is on this committee"; the index serves "which
  // committees is this person on", the heart of every visibility check.
  @@id([committeeId, userId])
  @@index([userId])
  @@map("committee_members")
  @@schema("committees")
}

model CommitteeMeeting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  committeeId String   @map("committee_id") @db.Uuid
  title       String
  scheduledAt DateTime @map("scheduled_at") @db.Timestamptz(6)
  location    String?
  description String?
  /// The person running the meeting: edits it and its agenda, and manages its tasks.
  organizerId String   @map("organizer_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  committee   Committee             @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  organizer   User                  @relation("CommitteeMeetingOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  agendaItems CommitteeAgendaItem[]
  tasks       CommitteeTask[]

  @@index([committeeId, scheduledAt])
  @@index([organizerId])
  @@index([scheduledAt])
  @@map("meetings")
  @@schema("committees")
}

model CommitteeAgendaItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId String  @map("meeting_id") @db.Uuid
  /// Order on the agenda, from 0. Not unique: moves swap two rows in one transaction.
  position  Int
  title     String
  notes     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  meeting CommitteeMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, position])
  @@map("agenda_items")
  @@schema("committees")
}

model CommitteeTask {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId       String              @map("meeting_id") @db.Uuid
  description     String
  /// "Expected outcome / next action": what done looks like, or the next step.
  /// Optional — tasks recorded before it existed have none.
  expectedOutcome String?             @map("expected_outcome")
  dueDate         DateTime            @map("due_date") @db.Date
  status          CommitteeTaskStatus @default(PENDING)
  /// Set exactly when the status is Completed (a CHECK holds the two together).
  completedAt     DateTime?           @map("completed_at") @db.Timestamptz(6)
  /// Replies with text, kept exact by a trigger on task_replies.
  replyCount      Int                 @default(0) @map("reply_count")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// The task's owner: the person who created it.
  createdBy String    @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  meeting   CommitteeMeeting        @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  creator   User                    @relation("CommitteeTaskCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  assignees CommitteeTaskAssignee[]
  replies   CommitteeTaskReply[]

  @@index([meetingId, dueDate])
  @@index([status, dueDate])
  @@index([dueDate])
  @@index([createdBy])
  @@map("tasks")
  @@schema("committees")
}

/// One responsible person on a task: a registered user, or a name typed in for
/// someone who has no account. Exactly one of the two (a CHECK enforces it).
model CommitteeTaskAssignee {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  manualName String?  @map("manual_name")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?  @map("created_by") @db.Uuid

  task CommitteeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User?         @relation("CommitteeTaskAssigneeUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([userId])
  @@map("task_assignees")
  @@schema("committees")
}

/// The task's discussion. Append-only (a trigger refuses UPDATE and DELETE), so the
/// history of a task is complete. An entry is a reply, a status change, or both.
model CommitteeTaskReply {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String               @map("task_id") @db.Uuid
  authorId   String               @map("author_id") @db.Uuid
  body       String?
  statusFrom CommitteeTaskStatus? @map("status_from")
  statusTo   CommitteeTaskStatus? @map("status_to")
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  task   CommitteeTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author User          @relation("CommitteeTaskReplyAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt, id])
  @@index([authorId])
  @@map("task_replies")
  @@schema("committees")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Mission expenses (ADR-037)
 */
/**
 * --------------------------------------------------------------------------
 */

enum CommitteeExpenseCategory {
  DINNER
  TRANSPORTATION
  VISA
  LUNCH
  COFFEE
  OTHER

  @@schema("committees")
}

enum CommitteeExpenseStatus {
  SUBMITTED
  APPROVED
  REJECTED

  @@schema("committees")
}

/// A receipt is PENDING from the moment its upload is authorised until the expense
/// that uses it is saved and the stored bytes have been checked; only READY ones are
/// served.
enum CommitteeReceiptStatus {
  PENDING
  READY

  @@schema("committees")
}

/// A business trip or visit that expenses are claimed against ("Turkey Trip").
/// Deactivated, never deleted: its expenses are its record.
model CommitteeMission {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  description     String?
  /// Offered first on the expense form; a claim may still be in another currency.
  defaultCurrency String  @map("default_currency") @db.Char(3)
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  expenses CommitteeMissionExpense[]

  @@index([isActive, name])
  @@map("missions")
  @@schema("committees")
}

/// A receipt picture in private object storage. Metadata only — never the bytes
/// (CLAUDE.md §12.1).
model CommitteeExpenseReceipt {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Random, server-chosen object key. The uploaded file name is never part of it.
  storageKey  String                 @unique @map("storage_key")
  fileName    String                 @map("file_name")
  /// Decided by the server from the verified content.
  contentType String                 @map("content_type")
  sizeBytes   Int                    @map("size_bytes")
  status      CommitteeReceiptStatus @default(PENDING)
  uploadedBy  String                 @map("uploaded_by") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  uploader User                     @relation("CommitteeReceiptUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  expense  CommitteeMissionExpense?

  @@index([uploadedBy, status])
  @@map("expense_receipts")
  @@schema("committees")
}

/// One claimed expense on a mission, by the person who paid it. Its details never
/// change after submission (a trigger enforces it): a mistake is rejected and
/// claimed again, so what was approved is what was claimed.
model CommitteeMissionExpense {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  missionId   String                   @map("mission_id") @db.Uuid
  /// Taken from the signed-in account, never typed.
  submittedBy String                   @map("submitted_by") @db.Uuid
  category    CommitteeExpenseCategory
  /// Required when the category is Other (a CHECK holds it).
  description String?
  expenseDate DateTime                 @map("expense_date") @db.Date
  /// Integer minor units of `currency` (ADR-006); every supported currency has two decimals.
  amountMinor Int                      @map("amount_minor")
  currency    String                   @db.Char(3)
  receiptId   String                   @unique @map("receipt_id") @db.Uuid
  status      CommitteeExpenseStatus   @default(SUBMITTED)
  reviewedBy  String?                  @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime?                @map("reviewed_at") @db.Timestamptz(6)
  reviewNote  String?                  @map("review_note")
  /// Set when an administrator deletes the claim; it then leaves every list and total (ADR-037).
  deletedAt   DateTime?                @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?                  @map("deleted_by") @db.Uuid

  /// The submission date.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mission   CommitteeMission        @relation(fields: [missionId], references: [id], onDelete: Restrict)
  submitter User                    @relation("CommitteeExpenseSubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)
  reviewer  User?                   @relation("CommitteeExpenseReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  deleter   User?                   @relation("CommitteeExpenseDeleter", fields: [deletedBy], references: [id], onDelete: Restrict)
  receipt   CommitteeExpenseReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@index([missionId, expenseDate])
  @@index([submittedBy, createdAt])
  @@index([status, createdAt])
  @@index([expenseDate])
  @@map("mission_expenses")
  @@schema("committees")
}
