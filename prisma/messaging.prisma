// Messaging — internal one-to-one chat.  Owner: modules/messaging.  Schema: "messaging".
//
// Conversations, their participants and their messages live here. What does NOT
// live here, by design (ADR-020):
//
//   - Online state and typing indicators. They are ephemeral and travel over
//     Supabase Realtime (Presence and Broadcast); only `last_seen_at` is stored.
//   - Documents. An attachment stores `ecm_document_id` and nothing else — ECM is
//     the platform's only document store (CLAUDE.md §6.3, §8.3).
//   - Delivery and read state per message. Each participant has two watermarks,
//     `last_delivered_at` and `last_read_at`; a message's status is derived by
//     comparing its `created_at` with the other participants' watermarks, so
//     reading a conversation is one UPDATE however many messages it had.
//
// Invariants Prisma cannot express — CHECKs, the participation and document-access
// triggers, row-level security and the Realtime authorization policies — are raw
// SQL in the migration that creates these tables.
//
// Models are prefixed `Msg` because Prisma model names share one namespace across
// every schema.

enum MsgConversationType {
  /// Exactly two participants, deduplicated by `direct_key`.
  DIRECT
  /// Reserved for group chat. Nothing creates one yet.
  GROUP

  @@schema("messaging")
}

enum MsgMessageType {
  TEXT
  /// Carries one or more `message_attachments` rows pointing at ECM documents.
  DOCUMENT
  /// Written by the platform, never by a person: no sender.
  SYSTEM

  @@schema("messaging")
}

model MsgConversation {
  id   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type MsgConversationType

  /// For DIRECT conversations, the two participant ids sorted and joined with ":".
  /// Unique, so two people can never end up with two direct conversations. NULL
  /// for any other type (enforced by a CHECK).
  directKey String? @unique @map("direct_key")

  /// Group conversations only.
  title String?

  /// Maintained by a trigger on message insert, so the inbox sorts without
  /// looking at messages.
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  participants MsgParticipant[]
  messages     MsgMessage[]

  @@map("conversations")
  @@schema("messaging")
}

model MsgParticipant {
  conversationId String @map("conversation_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  /// Watermarks: the `created_at` of the newest message this participant has
  /// received / read. Only ever moved forward.
  lastDeliveredAt DateTime? @map("last_delivered_at") @db.Timestamptz(6)
  lastReadAt      DateTime? @map("last_read_at") @db.Timestamptz(6)

  /// Set when a participant leaves a group. A direct conversation never sets it.
  leftAt DateTime? @map("left_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation MsgConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User            @relation("MsgParticipantUser", fields: [userId], references: [id], onDelete: Restrict)

  // The primary key serves "who is in this conversation"; the index serves the
  // inbox, "which conversations is this user in".
  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
  @@schema("messaging")
}

model MsgMessage {
  /// Supplied by the sending client as an idempotency key, so a retried send can
  /// never create a second copy; generated by the database otherwise.
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  /// The author, who is also the record's creator. NULL only for SYSTEM messages.
  senderId       String?        @map("sender_id") @db.Uuid
  type           MsgMessageType @default(TEXT) @map("message_type")
  content        String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  editedAt  DateTime? @map("edited_at") @db.Timestamptz(6)
  /// Soft delete: chat history is kept when a person is deactivated or deleted.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  conversation MsgConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender       User?           @relation("MsgMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  attachments  MsgAttachment[]

  /// Target of the attachments' composite foreign key, which guarantees an
  /// attachment's conversation is its message's conversation.
  @@unique([id, conversationId])
  /// History pages and unread counts: newest first within one conversation.
  @@index([conversationId, createdAt, id])
  @@index([senderId])
  @@map("messages")
  @@schema("messaging")
}

model MsgAttachment {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId      String @map("message_id") @db.Uuid
  /// Denormalised from the message (and held to it by the composite foreign key)
  /// so access checks need no join.
  conversationId String @map("conversation_id") @db.Uuid

  /// The shared ECM document. Plain ID column with NO foreign key: ECM owns the
  /// document (CLAUDE.md §8.3). Nothing about the document — name, size, type —
  /// is copied here; it is read from ECM with the VIEWER's permissions.
  ecmDocumentId String @map("ecm_document_id") @db.Uuid

  attachedBy String   @map("attached_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message  MsgMessage @relation(fields: [messageId, conversationId], references: [id, conversationId], onDelete: Cascade)
  attacher User       @relation("MsgAttachmentAttacher", fields: [attachedBy], references: [id], onDelete: Restrict)

  @@unique([messageId, ecmDocumentId])
  @@index([ecmDocumentId])
  @@index([attachedBy])
  @@map("message_attachments")
  @@schema("messaging")
}

/// When a person was last connected. Online state itself is never stored: it is
/// Realtime Presence. This row is written when a session connects and when it
/// leaves, at most once a minute per person.
model MsgPresence {
  userId     String   @id @map("user_id") @db.Uuid
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(6)

  user User @relation("MsgPresenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_presence")
  @@schema("messaging")
}
