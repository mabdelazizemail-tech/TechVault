// ERP — Enterprise Resource Planning.  Owner: modules/erp.  Schema: "erp".
//
// Phase 1 is the finance foundation (ADR-022): the chart of accounts, cost centres,
// accounting periods and the double-entry journal. Phase 2 adds accounts receivable
// (ADR-023): customer invoices, receipts, allocations, tax rates, payment methods,
// document numbering and AR settings. Payables, procurement, inventory, assets and
// projects arrive in later phases.
//
// Models are prefixed `Erp` because Prisma model and enum names share one namespace
// across every schema (CRM already has its own "Account").
//
// Money is a BIGINT in minor units (piastres) — never a float (ADR-006). ERP records
// in the functional currency, EGP, only.
//
// The accounting invariants are enforced by the database as well as the services:
// a posted entry balances, lives in an open period, uses active postable accounts,
// and can never be changed or deleted — only reversed. An invoice or receipt in the
// ledger is frozen the same way, and always matches its journal entry. See the raw
// SQL at the end of the migrations that create these tables.
//
// Customers are CRM accounts (§6.1): ERP stores `crm_account_id` with no foreign key
// and copies no CRM data.

/// The five fundamental account classes. Genuinely fixed, so an enum.
enum ErpAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@schema("erp")
}

/// The side on which an account's balance normally sits. Defaults from the type;
/// contra accounts (e.g. accumulated depreciation) carry the opposite.
enum ErpNormalBalance {
  DEBIT
  CREDIT

  @@schema("erp")
}

enum ErpPeriodStatus {
  OPEN
  CLOSED

  @@schema("erp")
}

/// DRAFT → POSTED → REVERSED. Only a draft may be edited or deleted.
enum ErpJournalStatus {
  DRAFT
  POSTED
  REVERSED

  @@schema("erp")
}

/// What a journal entry records (ADR-027). People enter STANDARD entries and
/// OPENING_BALANCE journals; YEAR_END_CLOSE entries are written only by year-end close.
enum ErpJournalKind {
  STANDARD
  OPENING_BALANCE
  YEAR_END_CLOSE

  @@schema("erp")
}

/// DRAFT → PENDING_APPROVAL → APPROVED → POSTED → PARTIALLY_PAID → PAID, or
/// CANCELLED (before posting, or voided by reversal while unpaid).
enum ErpArInvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED

  @@schema("erp")
}

/// DRAFT → POSTED, or CANCELLED (a draft, or voided by reversal while unallocated).
enum ErpArReceiptStatus {
  DRAFT
  POSTED
  CANCELLED

  @@schema("erp")
}

model ErpAccount {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String           @unique
  name          String
  nameAr        String?          @map("name_ar")
  type          ErpAccountType
  normalBalance ErpNormalBalance @map("normal_balance")
  parentId      String?          @map("parent_id") @db.Uuid
  /// Headings group accounts and take no postings; only postable accounts do.
  isPostable    Boolean          @default(true) @map("is_postable")
  isActive      Boolean          @default(true) @map("is_active")
  description   String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  parent   ErpAccount?      @relation("ErpAccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ErpAccount[]     @relation("ErpAccountTree")
  lines    ErpJournalLine[]

  arSettingsDefaults      ErpArSettings[]        @relation("ErpArDefaultReceivable")
  taxRates                ErpTaxRate[]           @relation("ErpTaxRateAccount")
  paymentMethodDeposits   ErpPaymentMethod[]     @relation("ErpPaymentMethodDeposit")
  arProfiles              ErpArCustomerProfile[] @relation("ErpArProfileReceivable")
  arInvoicesReceivable    ErpArInvoice[]         @relation("ErpArInvoiceReceivable")
  arInvoiceLines          ErpArInvoiceLine[]     @relation("ErpArInvoiceLineRevenue")
  arReceiptsDeposit       ErpArReceipt[]         @relation("ErpArReceiptDeposit")
  arReceiptsReceivable    ErpArReceipt[]         @relation("ErpArReceiptReceivable")
  arCreditNotesReceivable ErpArCreditNote[]      @relation("ErpArCreditNoteReceivable")
  arCreditNoteLines       ErpArCreditNoteLine[]  @relation("ErpArCreditNoteLineRevenue")

  taxRatesInput      ErpTaxRate[]            @relation("ErpTaxRateInputAccount")
  withholdingRates   ErpWithholdingTaxRate[] @relation("ErpWithholdingTaxRateAccount")
  apSettingsDefaults ErpApSettings[]         @relation("ErpApDefaultPayable")
  vendorsPayable     ErpVendor[]             @relation("ErpVendorPayable")
  vendorsExpense     ErpVendor[]             @relation("ErpVendorExpense")
  apBillsPayable     ErpApBill[]             @relation("ErpApBillPayable")
  apBillLines        ErpApBillLine[]         @relation("ErpApBillLineExpense")
  apPaymentsBank     ErpApPayment[]          @relation("ErpApPaymentBank")
  apPaymentsPayable  ErpApPayment[]          @relation("ErpApPaymentPayable")

  financeRetainedEarnings ErpFinanceSettings[] @relation("ErpFinanceRetainedEarnings")
  financeOpeningBalance   ErpFinanceSettings[] @relation("ErpFinanceOpeningBalance")
  fiscalYearCloses        ErpFiscalYearClose[] @relation("ErpFiscalYearCloseRetained")

  @@index([parentId])
  @@index([type, code])
  @@index([isActive])
  @@map("accounts")
  @@schema("erp")
}

model ErpCostCentre {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String  @unique
  name     String
  nameAr   String? @map("name_ar")
  parentId String? @map("parent_id") @db.Uuid
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  parent            ErpCostCentre?        @relation("ErpCostCentreTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          ErpCostCentre[]       @relation("ErpCostCentreTree")
  lines             ErpJournalLine[]
  arInvoiceLines    ErpArInvoiceLine[]
  arCreditNoteLines ErpArCreditNoteLine[]
  apBillLines       ErpApBillLine[]

  @@index([parentId])
  @@index([isActive])
  @@map("cost_centres")
  @@schema("erp")
}

/// An accounting period. Periods never overlap (exclusion constraint in the
/// migration) and no fiscal-year shape is assumed.
model ErpFiscalPeriod {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String          @unique
  startDate  DateTime        @map("start_date") @db.Date
  endDate    DateTime        @map("end_date") @db.Date
  status     ErpPeriodStatus @default(OPEN)
  closedAt   DateTime?       @map("closed_at") @db.Timestamptz(6)
  closedBy   String?         @map("closed_by") @db.Uuid
  reopenedAt DateTime?       @map("reopened_at") @db.Timestamptz(6)
  reopenedBy String?         @map("reopened_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  closer        User?             @relation("ErpPeriodCloser", fields: [closedBy], references: [id], onDelete: Restrict)
  reopener      User?             @relation("ErpPeriodReopener", fields: [reopenedBy], references: [id], onDelete: Restrict)
  entries       ErpJournalEntry[]
  arInvoices    ErpArInvoice[]
  arReceipts    ErpArReceipt[]
  arCreditNotes ErpArCreditNote[]
  apBills       ErpApBill[]
  apPayments    ErpApPayment[]

  @@index([startDate])
  @@index([status])
  @@map("fiscal_periods")
  @@schema("erp")
}

model ErpJournalEntry {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// JE-2026-000001, assigned when the entry is posted from a gap-free yearly counter.
  journalNumber   String?          @unique @map("journal_number")
  entryDate       DateTime         @map("entry_date") @db.Date
  description     String
  reference       String?
  status          ErpJournalStatus @default(DRAFT)
  kind            ErpJournalKind   @default(STANDARD)
  /// Set when the entry is posted: the open period containing its date.
  fiscalPeriodId  String?          @map("fiscal_period_id") @db.Uuid
  /// Total debits (= total credits), kept in step with the lines and verified by the
  /// database at posting, so lists show amounts without summing lines.
  totalMinor      BigInt           @default(0) @map("total_minor")
  /// The document that raised the entry, e.g. an AR invoice. All three or none.
  sourceModule    String?          @map("source_module")
  sourceType      String?          @map("source_type")
  sourceId        String?          @map("source_id")
  postedAt        DateTime?        @map("posted_at") @db.Timestamptz(6)
  postedBy        String?          @map("posted_by") @db.Uuid
  /// On a reversal entry: the posted entry it reverses. One reversal per entry.
  reversesEntryId String?          @unique @map("reverses_entry_id") @db.Uuid
  reversedAt      DateTime?        @map("reversed_at") @db.Timestamptz(6)
  reversedBy      String?          @map("reversed_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  period   ErpFiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  creator  User             @relation("ErpJournalCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  poster   User?            @relation("ErpJournalPoster", fields: [postedBy], references: [id], onDelete: Restrict)
  reverser User?            @relation("ErpJournalReverser", fields: [reversedBy], references: [id], onDelete: Restrict)
  reverses ErpJournalEntry? @relation("ErpJournalReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversal ErpJournalEntry? @relation("ErpJournalReversal")
  lines    ErpJournalLine[]

  arInvoice     ErpArInvoice? @relation("ErpArInvoiceJournal")
  arInvoiceVoid ErpArInvoice? @relation("ErpArInvoiceVoidJournal")
  arReceipt     ErpArReceipt? @relation("ErpArReceiptJournal")
  arReceiptVoid ErpArReceipt? @relation("ErpArReceiptVoidJournal")

  arCreditNote     ErpArCreditNote? @relation("ErpArCreditNoteJournal")
  arCreditNoteVoid ErpArCreditNote? @relation("ErpArCreditNoteVoidJournal")

  apBill        ErpApBill?    @relation("ErpApBillJournal")
  apBillVoid    ErpApBill?    @relation("ErpApBillVoidJournal")
  apPayment     ErpApPayment? @relation("ErpApPaymentJournal")
  apPaymentVoid ErpApPayment? @relation("ErpApPaymentVoidJournal")

  fiscalYearClose  ErpFiscalYearClose? @relation("ErpFiscalYearCloseEntry")
  fiscalYearReopen ErpFiscalYearClose? @relation("ErpFiscalYearReopenEntry")

  @@index([status, entryDate(sort: Desc)])
  @@index([entryDate(sort: Desc)])
  @@index([fiscalPeriodId])
  @@index([kind, entryDate(sort: Desc)])
  @@index([sourceModule, sourceType, sourceId])
  @@index([createdBy])
  @@map("journal_entries")
  @@schema("erp")
}

model ErpJournalLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalEntryId String  @map("journal_entry_id") @db.Uuid
  lineNo         Int     @map("line_no")
  accountId      String  @map("account_id") @db.Uuid
  costCentreId   String? @map("cost_centre_id") @db.Uuid
  description    String?
  /// Exactly one of debit and credit is above zero (CHECK in the migration).
  debitMinor     BigInt  @default(0) @map("debit_minor")
  creditMinor    BigInt  @default(0) @map("credit_minor")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  entry      ErpJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account    ErpAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  costCentre ErpCostCentre?  @relation(fields: [costCentreId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, lineNo])
  @@index([accountId])
  @@index([costCentreId])
  @@map("journal_lines")
  @@schema("erp")
}

/// The gap-free journal number counter, one row per calendar year of entry date.
/// Taken inside the posting transaction, so a rolled-back posting consumes nothing.
model ErpJournalSequence {
  year       Int      @id
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("journal_sequences")
  @@schema("erp")
}

// ---------------------------------------------------------------------------
// Accounts receivable (ADR-023)
// ---------------------------------------------------------------------------

/// AR configuration: one row, id = 1. Approval rules, defaults and aging buckets are
/// data an administrator changes, never code.
model ErpArSettings {
  id                         Int     @id @default(1)
  defaultReceivableAccountId String? @map("default_receivable_account_id") @db.Uuid
  invoiceApprovalRequired    Boolean @default(true) @map("invoice_approval_required")
  /// When set, only invoices at or above this total need approval.
  approvalThresholdMinor     BigInt? @map("approval_threshold_minor")
  /// Off by default: nobody approves an invoice they created or submitted (§13.3).
  allowSelfApproval          Boolean @default(false) @map("allow_self_approval")
  defaultPaymentTermsDays    Int     @default(30) @map("default_payment_terms_days")
  /// Aging boundaries in days past due: [30, 60, 90, 120] gives Current, 1–30, …, 120+.
  agingBucketDays            Int[]   @default([30, 60, 90, 120]) @map("aging_bucket_days")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  defaultReceivableAccount ErpAccount? @relation("ErpArDefaultReceivable", fields: [defaultReceivableAccountId], references: [id], onDelete: Restrict)

  @@map("ar_settings")
  @@schema("erp")
}

/// How a document type is numbered: INV-2026-000001. Numbers are assigned at posting.
model ErpNumberSeries {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// AR_INVOICE or AR_RECEIPT.
  documentType String  @unique @map("document_type")
  prefix       String
  padding      Int     @default(6)
  resetsYearly Boolean @default(true) @map("resets_yearly")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  counters ErpNumberSeriesCounter[]

  @@map("number_series")
  @@schema("erp")
}

/// The last number used per series and year (year 0 for a series that never resets).
model ErpNumberSeriesCounter {
  seriesId   String   @map("series_id") @db.Uuid
  year       Int
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  series ErpNumberSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, year])
  @@map("number_series_counters")
  @@schema("erp")
}

/// A tax rate is data (§25.3): the rate in basis points (1400 = 14%) and the
/// liability account its tax is credited to. Lines copy the rate when calculated.
model ErpTaxRate {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String  @unique
  name              String
  nameAr            String? @map("name_ar")
  rateBasisPoints   Int     @map("rate_basis_points")
  /// Output tax on sales is credited here (a liability).
  taxAccountId      String  @map("tax_account_id") @db.Uuid
  /// Input tax on purchases is debited here — recoverable VAT to an asset account, or
  /// an expense account when it cannot be reclaimed. A rate without one is not
  /// offered on vendor bills (ADR-033).
  inputTaxAccountId String? @map("input_tax_account_id") @db.Uuid
  isActive          Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  taxAccount      ErpAccount            @relation("ErpTaxRateAccount", fields: [taxAccountId], references: [id], onDelete: Restrict)
  inputTaxAccount ErpAccount?           @relation("ErpTaxRateInputAccount", fields: [inputTaxAccountId], references: [id], onDelete: Restrict)
  invoiceLines    ErpArInvoiceLine[]
  creditNoteLines ErpArCreditNoteLine[]
  billLines       ErpApBillLine[]

  @@index([isActive])
  @@map("tax_rates")
  @@schema("erp")
}

model ErpPaymentMethod {
  id                      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                    String  @unique
  name                    String
  nameAr                  String? @map("name_ar")
  /// Suggested bank or cash account for receipts taken this way.
  defaultDepositAccountId String? @map("default_deposit_account_id") @db.Uuid
  isActive                Boolean @default(true) @map("is_active")
  sortOrder               Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  defaultDepositAccount ErpAccount?    @relation("ErpPaymentMethodDeposit", fields: [defaultDepositAccountId], references: [id], onDelete: Restrict)
  receipts              ErpArReceipt[]
  apPayments            ErpApPayment[]

  @@index([isActive, sortOrder])
  @@map("payment_methods")
  @@schema("erp")
}

/// Accounting terms for a CRM customer. Holds no CRM data — only the id (§8.3).
model ErpArCustomerProfile {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  crmAccountId        String  @unique @map("crm_account_id") @db.Uuid
  paymentTermsDays    Int?    @map("payment_terms_days")
  /// Shown against the balance; not enforced in Phase 2.
  creditLimitMinor    BigInt? @map("credit_limit_minor")
  receivableAccountId String? @map("receivable_account_id") @db.Uuid
  notes               String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  receivableAccount ErpAccount? @relation("ErpArProfileReceivable", fields: [receivableAccountId], references: [id], onDelete: Restrict)

  @@map("ar_customer_profiles")
  @@schema("erp")
}

model ErpArInvoice {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Assigned at posting from the AR_INVOICE number series.
  invoiceNumber       String?            @unique @map("invoice_number")
  crmAccountId        String             @map("crm_account_id") @db.Uuid
  invoiceDate         DateTime           @map("invoice_date") @db.Date
  dueDate             DateTime           @map("due_date") @db.Date
  currency            String             @default("EGP") @db.Char(3)
  status              ErpArInvoiceStatus @default(DRAFT)
  /// Calculated by the server from the lines and re-checked by the database.
  subtotalMinor       BigInt             @default(0) @map("subtotal_minor")
  discountMinor       BigInt             @default(0) @map("discount_minor")
  taxMinor            BigInt             @default(0) @map("tax_minor")
  totalMinor          BigInt             @default(0) @map("total_minor")
  /// Maintained by the allocation trigger and reconciled with the allocations at commit.
  paidMinor           BigInt             @default(0) @map("paid_minor")
  /// total − paid while the invoice is in the ledger; 0 otherwise.
  outstandingMinor    BigInt             @default(0) @map("outstanding_minor")
  /// Credited by posted credit notes (ADR-029), maintained by their trigger.
  creditedMinor       BigInt             @default(0) @map("credited_minor")
  reference           String?
  notes               String?
  receivableAccountId String             @map("receivable_account_id") @db.Uuid
  fiscalPeriodId      String?            @map("fiscal_period_id") @db.Uuid
  journalEntryId      String?            @unique @map("journal_entry_id") @db.Uuid
  voidJournalEntryId  String?            @unique @map("void_journal_entry_id") @db.Uuid

  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(6)
  submittedBy     String?   @map("submitted_by") @db.Uuid
  /// True when the invoice was below the approval rule and approved automatically.
  approvalSkipped Boolean   @default(false) @map("approval_skipped")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy      String?   @map("approved_by") @db.Uuid
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy      String?   @map("rejected_by") @db.Uuid
  rejectionReason String?   @map("rejection_reason")
  postedAt        DateTime? @map("posted_at") @db.Timestamptz(6)
  postedBy        String?   @map("posted_by") @db.Uuid
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?   @map("cancelled_by") @db.Uuid
  cancelReason    String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  receivableAccount ErpAccount               @relation("ErpArInvoiceReceivable", fields: [receivableAccountId], references: [id], onDelete: Restrict)
  period            ErpFiscalPeriod?         @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  journalEntry      ErpJournalEntry?         @relation("ErpArInvoiceJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  voidJournalEntry  ErpJournalEntry?         @relation("ErpArInvoiceVoidJournal", fields: [voidJournalEntryId], references: [id], onDelete: Restrict)
  creator           User                     @relation("ErpArInvoiceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver          User?                    @relation("ErpArInvoiceApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  poster            User?                    @relation("ErpArInvoicePoster", fields: [postedBy], references: [id], onDelete: Restrict)
  lines             ErpArInvoiceLine[]
  allocations       ErpArReceiptAllocation[]
  creditNotes       ErpArCreditNote[]

  @@index([crmAccountId, status])
  @@index([status, invoiceDate(sort: Desc)])
  @@index([invoiceDate(sort: Desc)])
  @@index([dueDate])
  @@index([outstandingMinor, dueDate])
  @@index([fiscalPeriodId])
  @@index([createdBy])
  @@map("ar_invoices")
  @@schema("erp")
}

model ErpArInvoiceLine {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId          String  @map("invoice_id") @db.Uuid
  lineNo             Int     @map("line_no")
  description        String
  /// Exact decimal, four places.
  quantity           Decimal @db.Decimal(18, 4)
  unitPriceMinor     BigInt  @map("unit_price_minor")
  grossMinor         BigInt  @map("gross_minor")
  discountMinor      BigInt  @default(0) @map("discount_minor")
  netMinor           BigInt  @map("net_minor")
  taxRateId          String? @map("tax_rate_id") @db.Uuid
  /// The rate as it was when the line was calculated.
  taxRateBasisPoints Int?    @map("tax_rate_basis_points")
  taxMinor           BigInt  @default(0) @map("tax_minor")
  totalMinor         BigInt  @map("total_minor")
  revenueAccountId   String  @map("revenue_account_id") @db.Uuid
  costCentreId       String? @map("cost_centre_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice        ErpArInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taxRate        ErpTaxRate?    @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  revenueAccount ErpAccount     @relation("ErpArInvoiceLineRevenue", fields: [revenueAccountId], references: [id], onDelete: Restrict)
  costCentre     ErpCostCentre? @relation(fields: [costCentreId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, lineNo])
  @@index([revenueAccountId])
  @@index([taxRateId])
  @@index([costCentreId])
  @@map("ar_invoice_lines")
  @@schema("erp")
}

model ErpArReceipt {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Assigned at posting from the AR_RECEIPT number series.
  receiptNumber       String?            @unique @map("receipt_number")
  crmAccountId        String             @map("crm_account_id") @db.Uuid
  receiptDate         DateTime           @map("receipt_date") @db.Date
  amountMinor         BigInt             @map("amount_minor")
  currency            String             @default("EGP") @db.Char(3)
  paymentMethodId     String             @map("payment_method_id") @db.Uuid
  depositAccountId    String             @map("deposit_account_id") @db.Uuid
  receivableAccountId String             @map("receivable_account_id") @db.Uuid
  reference           String?
  notes               String?
  status              ErpArReceiptStatus @default(DRAFT)
  /// Maintained by the allocation trigger and reconciled with the allocations at commit.
  allocatedMinor      BigInt             @default(0) @map("allocated_minor")
  fiscalPeriodId      String?            @map("fiscal_period_id") @db.Uuid
  journalEntryId      String?            @unique @map("journal_entry_id") @db.Uuid
  voidJournalEntryId  String?            @unique @map("void_journal_entry_id") @db.Uuid
  postedAt            DateTime?          @map("posted_at") @db.Timestamptz(6)
  postedBy            String?            @map("posted_by") @db.Uuid
  cancelledAt         DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy         String?            @map("cancelled_by") @db.Uuid
  cancelReason        String?            @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  paymentMethod     ErpPaymentMethod         @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  depositAccount    ErpAccount               @relation("ErpArReceiptDeposit", fields: [depositAccountId], references: [id], onDelete: Restrict)
  receivableAccount ErpAccount               @relation("ErpArReceiptReceivable", fields: [receivableAccountId], references: [id], onDelete: Restrict)
  period            ErpFiscalPeriod?         @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  journalEntry      ErpJournalEntry?         @relation("ErpArReceiptJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  voidJournalEntry  ErpJournalEntry?         @relation("ErpArReceiptVoidJournal", fields: [voidJournalEntryId], references: [id], onDelete: Restrict)
  creator           User                     @relation("ErpArReceiptCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  poster            User?                    @relation("ErpArReceiptPoster", fields: [postedBy], references: [id], onDelete: Restrict)
  allocations       ErpArReceiptAllocation[]

  @@index([crmAccountId, status])
  @@index([status, receiptDate(sort: Desc)])
  @@index([receiptDate(sort: Desc)])
  @@index([paymentMethodId])
  @@index([fiscalPeriodId])
  @@map("ar_receipts")
  @@schema("erp")
}

/// Matches part of a posted receipt to a posted invoice of the same customer. It moves
/// no money in the ledger — the receipt already credited receivables.
model ErpArReceiptAllocation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId   String   @map("receipt_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  amountMinor BigInt   @map("amount_minor")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String   @map("created_by") @db.Uuid

  receipt ErpArReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  invoice ErpArInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([receiptId, invoiceId])
  @@index([invoiceId])
  @@map("ar_receipt_allocations")
  @@schema("erp")
}

// ---------------------------------------------------------------------------
// Finance settings (ADR-027)
// ---------------------------------------------------------------------------

/// Finance configuration: one row, id = 1. Data an administrator changes, never code.
model ErpFinanceSettings {
  id                        Int     @id @default(1)
  /// Off by default: nobody posts a manual journal entry they created or last edited.
  allowSelfPosting          Boolean @default(false) @map("allow_self_posting")
  /// The equity account year-end close moves each year's profit or loss into.
  retainedEarningsAccountId String? @map("retained_earnings_account_id") @db.Uuid
  /// The equity account that balances an opening balance journal.
  openingBalanceAccountId   String? @map("opening_balance_account_id") @db.Uuid

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  retainedEarningsAccount ErpAccount? @relation("ErpFinanceRetainedEarnings", fields: [retainedEarningsAccountId], references: [id], onDelete: Restrict)
  openingBalanceAccount   ErpAccount? @relation("ErpFinanceOpeningBalance", fields: [openingBalanceAccountId], references: [id], onDelete: Restrict)

  @@map("finance_settings")
  @@schema("erp")
}

// ---------------------------------------------------------------------------
// Year-end close (ADR-028)
// ---------------------------------------------------------------------------

/// A calendar fiscal year closed into retained earnings. Reopening keeps the row as
/// history; a partial unique index allows one live (not reopened) close per year.
model ErpFiscalYearClose {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year                      Int
  /// The YEAR_END_CLOSE entry; null when nothing moved in the year's revenue or expenses.
  journalEntryId            String?   @unique @map("journal_entry_id") @db.Uuid
  /// The profit (positive) or loss (negative) moved into retained earnings.
  netIncomeMinor            BigInt    @map("net_income_minor")
  retainedEarningsAccountId String    @map("retained_earnings_account_id") @db.Uuid
  closedAt                  DateTime  @default(now()) @map("closed_at") @db.Timestamptz(6)
  closedBy                  String    @map("closed_by") @db.Uuid
  reopenedAt                DateTime? @map("reopened_at") @db.Timestamptz(6)
  reopenedBy                String?   @map("reopened_by") @db.Uuid
  reopenReason              String?   @map("reopen_reason")
  /// The reversal of the closing entry, posted when the year was reopened.
  reopenJournalEntryId      String?   @unique @map("reopen_journal_entry_id") @db.Uuid

  journalEntry            ErpJournalEntry? @relation("ErpFiscalYearCloseEntry", fields: [journalEntryId], references: [id], onDelete: Restrict)
  reopenJournalEntry      ErpJournalEntry? @relation("ErpFiscalYearReopenEntry", fields: [reopenJournalEntryId], references: [id], onDelete: Restrict)
  retainedEarningsAccount ErpAccount       @relation("ErpFiscalYearCloseRetained", fields: [retainedEarningsAccountId], references: [id], onDelete: Restrict)
  closer                  User             @relation("ErpFiscalYearCloser", fields: [closedBy], references: [id], onDelete: Restrict)
  reopener                User?            @relation("ErpFiscalYearReopener", fields: [reopenedBy], references: [id], onDelete: Restrict)

  @@index([year])
  @@map("fiscal_year_closes")
  @@schema("erp")
}

// ---------------------------------------------------------------------------
// Credit notes (ADR-029)
// ---------------------------------------------------------------------------

/// DRAFT → PENDING_APPROVAL → APPROVED → POSTED, or CANCELLED (before posting, or
/// voided by reversal).
enum ErpArCreditNoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  CANCELLED

  @@schema("erp")
}

/// A correction against ONE posted invoice, for at most what that invoice still owes.
/// Posting it reduces the invoice's outstanding amount through a database trigger.
model ErpArCreditNote {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Assigned at posting from the AR_CREDIT_NOTE number series.
  creditNoteNumber    String?               @unique @map("credit_note_number")
  invoiceId           String                @map("invoice_id") @db.Uuid
  /// Copied from the invoice, so lists and balances need no join to filter by customer.
  crmAccountId        String                @map("crm_account_id") @db.Uuid
  creditNoteDate      DateTime              @map("credit_note_date") @db.Date
  currency            String                @default("EGP") @db.Char(3)
  status              ErpArCreditNoteStatus @default(DRAFT)
  subtotalMinor       BigInt                @default(0) @map("subtotal_minor")
  discountMinor       BigInt                @default(0) @map("discount_minor")
  taxMinor            BigInt                @default(0) @map("tax_minor")
  totalMinor          BigInt                @default(0) @map("total_minor")
  reason              String
  notes               String?
  receivableAccountId String                @map("receivable_account_id") @db.Uuid
  fiscalPeriodId      String?               @map("fiscal_period_id") @db.Uuid
  journalEntryId      String?               @unique @map("journal_entry_id") @db.Uuid
  voidJournalEntryId  String?               @unique @map("void_journal_entry_id") @db.Uuid

  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(6)
  submittedBy     String?   @map("submitted_by") @db.Uuid
  approvalSkipped Boolean   @default(false) @map("approval_skipped")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy      String?   @map("approved_by") @db.Uuid
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy      String?   @map("rejected_by") @db.Uuid
  rejectionReason String?   @map("rejection_reason")
  postedAt        DateTime? @map("posted_at") @db.Timestamptz(6)
  postedBy        String?   @map("posted_by") @db.Uuid
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?   @map("cancelled_by") @db.Uuid
  cancelReason    String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  invoice           ErpArInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receivableAccount ErpAccount            @relation("ErpArCreditNoteReceivable", fields: [receivableAccountId], references: [id], onDelete: Restrict)
  period            ErpFiscalPeriod?      @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  journalEntry      ErpJournalEntry?      @relation("ErpArCreditNoteJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  voidJournalEntry  ErpJournalEntry?      @relation("ErpArCreditNoteVoidJournal", fields: [voidJournalEntryId], references: [id], onDelete: Restrict)
  creator           User                  @relation("ErpArCreditNoteCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver          User?                 @relation("ErpArCreditNoteApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  poster            User?                 @relation("ErpArCreditNotePoster", fields: [postedBy], references: [id], onDelete: Restrict)
  lines             ErpArCreditNoteLine[]

  @@index([invoiceId])
  @@index([crmAccountId, status])
  @@index([status, creditNoteDate(sort: Desc)])
  @@index([creditNoteDate(sort: Desc)])
  @@index([fiscalPeriodId])
  @@index([createdBy])
  @@map("ar_credit_notes")
  @@schema("erp")
}

model ErpArCreditNoteLine {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creditNoteId       String  @map("credit_note_id") @db.Uuid
  lineNo             Int     @map("line_no")
  description        String
  quantity           Decimal @db.Decimal(18, 4)
  unitPriceMinor     BigInt  @map("unit_price_minor")
  grossMinor         BigInt  @map("gross_minor")
  discountMinor      BigInt  @default(0) @map("discount_minor")
  netMinor           BigInt  @map("net_minor")
  taxRateId          String? @map("tax_rate_id") @db.Uuid
  taxRateBasisPoints Int?    @map("tax_rate_basis_points")
  taxMinor           BigInt  @default(0) @map("tax_minor")
  totalMinor         BigInt  @map("total_minor")
  revenueAccountId   String  @map("revenue_account_id") @db.Uuid
  costCentreId       String? @map("cost_centre_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creditNote     ErpArCreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  taxRate        ErpTaxRate?     @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  revenueAccount ErpAccount      @relation("ErpArCreditNoteLineRevenue", fields: [revenueAccountId], references: [id], onDelete: Restrict)
  costCentre     ErpCostCentre?  @relation(fields: [costCentreId], references: [id], onDelete: Restrict)

  @@unique([creditNoteId, lineNo])
  @@index([revenueAccountId])
  @@index([taxRateId])
  @@index([costCentreId])
  @@map("ar_credit_note_lines")
  @@schema("erp")
}

// ---------------------------------------------------------------------------
// Accounts payable (ADR-033): vendors, bills, supplier payments with withholding.
// ---------------------------------------------------------------------------

enum ErpApBillStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED

  @@schema("erp")
}

enum ErpApPaymentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  CANCELLED

  @@schema("erp")
}

/// Accounts payable configuration: one row, id = 1. Data an administrator changes.
model ErpApSettings {
  id                            Int     @id @default(1)
  defaultPayableAccountId       String? @map("default_payable_account_id") @db.Uuid
  billApprovalRequired          Boolean @default(true) @map("bill_approval_required")
  /// When set, only bills at or above this total need approval.
  billApprovalThresholdMinor    BigInt? @map("bill_approval_threshold_minor")
  paymentApprovalRequired       Boolean @default(true) @map("payment_approval_required")
  /// When set, only payments settling at least this much need approval.
  paymentApprovalThresholdMinor BigInt? @map("payment_approval_threshold_minor")
  /// Off by default: nobody approves a bill or payment they created or submitted (§13.3).
  allowSelfApproval             Boolean @default(false) @map("allow_self_approval")
  defaultPaymentTermsDays       Int     @default(30) @map("default_payment_terms_days")
  agingBucketDays               Int[]   @default([30, 60, 90, 120]) @map("aging_bucket_days")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  defaultPayableAccount ErpAccount? @relation("ErpApDefaultPayable", fields: [defaultPayableAccountId], references: [id], onDelete: Restrict)

  @@map("ap_settings")
  @@schema("erp")
}

/// A withholding tax rate deducted when a supplier is paid, credited to a liability
/// account until it is remitted to the tax authority (ADR-033).
model ErpWithholdingTaxRate {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String  @unique
  name             String
  nameAr           String? @map("name_ar")
  rateBasisPoints  Int     @map("rate_basis_points")
  payableAccountId String  @map("payable_account_id") @db.Uuid
  isActive         Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  payableAccount ErpAccount         @relation("ErpWithholdingTaxRateAccount", fields: [payableAccountId], references: [id], onDelete: Restrict)
  vendors        ErpVendor[]
  paymentLines   ErpApPaymentLine[]

  @@index([isActive])
  @@map("withholding_tax_rates")
  @@schema("erp")
}

/// A supplier. ERP owns the vendor master (§26); a vendor may point at the CRM
/// company that is the same business, by id only (§8.3).
model ErpVendor {
  id                          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                        String
  nameAr                      String? @map("name_ar")
  taxRegistrationNumber       String? @map("tax_registration_number")
  /// Optional link to the CRM company that is the same business. No foreign key.
  crmAccountId                String? @map("crm_account_id") @db.Uuid
  email                       String?
  phone                       String?
  address                     String?
  paymentTermsDays            Int?    @map("payment_terms_days")
  payableAccountId            String? @map("payable_account_id") @db.Uuid
  defaultExpenseAccountId     String? @map("default_expense_account_id") @db.Uuid
  defaultWithholdingTaxRateId String? @map("default_withholding_tax_rate_id") @db.Uuid
  notes                       String?
  isActive                    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  payableAccount            ErpAccount?            @relation("ErpVendorPayable", fields: [payableAccountId], references: [id], onDelete: Restrict)
  defaultExpenseAccount     ErpAccount?            @relation("ErpVendorExpense", fields: [defaultExpenseAccountId], references: [id], onDelete: Restrict)
  defaultWithholdingTaxRate ErpWithholdingTaxRate? @relation(fields: [defaultWithholdingTaxRateId], references: [id], onDelete: Restrict)
  bills                     ErpApBill[]
  payments                  ErpApPayment[]

  @@index([isActive, name])
  @@index([crmAccountId])
  @@map("vendors")
  @@schema("erp")
}

model ErpApBill {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Assigned at posting from the AP_BILL number series.
  billNumber          String?         @unique @map("bill_number")
  vendorId            String          @map("vendor_id") @db.Uuid
  /// The supplier's own invoice number; unique per vendor among live bills.
  vendorInvoiceNumber String          @map("vendor_invoice_number")
  billDate            DateTime        @map("bill_date") @db.Date
  dueDate             DateTime        @map("due_date") @db.Date
  currency            String          @default("EGP") @db.Char(3)
  status              ErpApBillStatus @default(DRAFT)
  subtotalMinor       BigInt          @default(0) @map("subtotal_minor")
  discountMinor       BigInt          @default(0) @map("discount_minor")
  taxMinor            BigInt          @default(0) @map("tax_minor")
  totalMinor          BigInt          @default(0) @map("total_minor")
  /// Settled by posted payments (cash plus tax withheld), maintained by their trigger.
  paidMinor           BigInt          @default(0) @map("paid_minor")
  outstandingMinor    BigInt          @default(0) @map("outstanding_minor")
  reference           String?
  notes               String?
  payableAccountId    String          @map("payable_account_id") @db.Uuid
  fiscalPeriodId      String?         @map("fiscal_period_id") @db.Uuid
  journalEntryId      String?         @unique @map("journal_entry_id") @db.Uuid
  voidJournalEntryId  String?         @unique @map("void_journal_entry_id") @db.Uuid

  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(6)
  submittedBy     String?   @map("submitted_by") @db.Uuid
  approvalSkipped Boolean   @default(false) @map("approval_skipped")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy      String?   @map("approved_by") @db.Uuid
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy      String?   @map("rejected_by") @db.Uuid
  rejectionReason String?   @map("rejection_reason")
  postedAt        DateTime? @map("posted_at") @db.Timestamptz(6)
  postedBy        String?   @map("posted_by") @db.Uuid
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?   @map("cancelled_by") @db.Uuid
  cancelReason    String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  vendor           ErpVendor          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  payableAccount   ErpAccount         @relation("ErpApBillPayable", fields: [payableAccountId], references: [id], onDelete: Restrict)
  period           ErpFiscalPeriod?   @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  journalEntry     ErpJournalEntry?   @relation("ErpApBillJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  voidJournalEntry ErpJournalEntry?   @relation("ErpApBillVoidJournal", fields: [voidJournalEntryId], references: [id], onDelete: Restrict)
  creator          User               @relation("ErpApBillCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver         User?              @relation("ErpApBillApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  poster           User?              @relation("ErpApBillPoster", fields: [postedBy], references: [id], onDelete: Restrict)
  lines            ErpApBillLine[]
  paymentLines     ErpApPaymentLine[]

  @@index([vendorId, status])
  @@index([status, billDate(sort: Desc)])
  @@index([billDate(sort: Desc)])
  @@index([dueDate])
  @@index([outstandingMinor, dueDate])
  @@index([fiscalPeriodId])
  @@index([createdBy])
  @@map("ap_bills")
  @@schema("erp")
}

model ErpApBillLine {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId             String  @map("bill_id") @db.Uuid
  lineNo             Int     @map("line_no")
  description        String
  quantity           Decimal @db.Decimal(18, 4)
  unitPriceMinor     BigInt  @map("unit_price_minor")
  grossMinor         BigInt  @map("gross_minor")
  discountMinor      BigInt  @default(0) @map("discount_minor")
  netMinor           BigInt  @map("net_minor")
  taxRateId          String? @map("tax_rate_id") @db.Uuid
  taxRateBasisPoints Int?    @map("tax_rate_basis_points")
  taxMinor           BigInt  @default(0) @map("tax_minor")
  totalMinor         BigInt  @map("total_minor")
  /// An expense account, or an asset account for something bought to keep.
  expenseAccountId   String  @map("expense_account_id") @db.Uuid
  costCentreId       String? @map("cost_centre_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  bill           ErpApBill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  taxRate        ErpTaxRate?    @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  expenseAccount ErpAccount     @relation("ErpApBillLineExpense", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  costCentre     ErpCostCentre? @relation(fields: [costCentreId], references: [id], onDelete: Restrict)

  @@unique([billId, lineNo])
  @@index([expenseAccountId])
  @@index([taxRateId])
  @@index([costCentreId])
  @@map("ap_bill_lines")
  @@schema("erp")
}

/// A payment to one vendor, settling one or more of its posted bills. Each line may
/// withhold tax; the vendor receives the cash, the tax authority the rest.
model ErpApPayment {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Assigned at posting from the AP_PAYMENT number series.
  paymentNumber      String?            @unique @map("payment_number")
  vendorId           String             @map("vendor_id") @db.Uuid
  paymentDate        DateTime           @map("payment_date") @db.Date
  currency           String             @default("EGP") @db.Char(3)
  status             ErpApPaymentStatus @default(DRAFT)
  /// Bills settled: the sum of the lines' amounts.
  amountMinor        BigInt             @default(0) @map("amount_minor")
  /// Tax withheld across the lines.
  withheldMinor      BigInt             @default(0) @map("withheld_minor")
  /// Paid out of the bank: amount − withheld.
  cashMinor          BigInt             @default(0) @map("cash_minor")
  paymentMethodId    String             @map("payment_method_id") @db.Uuid
  bankAccountId      String             @map("bank_account_id") @db.Uuid
  payableAccountId   String             @map("payable_account_id") @db.Uuid
  reference          String?
  notes              String?
  fiscalPeriodId     String?            @map("fiscal_period_id") @db.Uuid
  journalEntryId     String?            @unique @map("journal_entry_id") @db.Uuid
  voidJournalEntryId String?            @unique @map("void_journal_entry_id") @db.Uuid

  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(6)
  submittedBy     String?   @map("submitted_by") @db.Uuid
  approvalSkipped Boolean   @default(false) @map("approval_skipped")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy      String?   @map("approved_by") @db.Uuid
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy      String?   @map("rejected_by") @db.Uuid
  rejectionReason String?   @map("rejection_reason")
  postedAt        DateTime? @map("posted_at") @db.Timestamptz(6)
  postedBy        String?   @map("posted_by") @db.Uuid
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?   @map("cancelled_by") @db.Uuid
  cancelReason    String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  vendor           ErpVendor          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  paymentMethod    ErpPaymentMethod   @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  bankAccount      ErpAccount         @relation("ErpApPaymentBank", fields: [bankAccountId], references: [id], onDelete: Restrict)
  payableAccount   ErpAccount         @relation("ErpApPaymentPayable", fields: [payableAccountId], references: [id], onDelete: Restrict)
  period           ErpFiscalPeriod?   @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  journalEntry     ErpJournalEntry?   @relation("ErpApPaymentJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  voidJournalEntry ErpJournalEntry?   @relation("ErpApPaymentVoidJournal", fields: [voidJournalEntryId], references: [id], onDelete: Restrict)
  creator          User               @relation("ErpApPaymentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver         User?              @relation("ErpApPaymentApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  poster           User?              @relation("ErpApPaymentPoster", fields: [postedBy], references: [id], onDelete: Restrict)
  lines            ErpApPaymentLine[]

  @@index([vendorId, status])
  @@index([status, paymentDate(sort: Desc)])
  @@index([paymentDate(sort: Desc)])
  @@index([paymentMethodId])
  @@index([fiscalPeriodId])
  @@index([createdBy])
  @@map("ap_payments")
  @@schema("erp")
}

model ErpApPaymentLine {
  id                     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId              String  @map("payment_id") @db.Uuid
  lineNo                 Int     @map("line_no")
  billId                 String  @map("bill_id") @db.Uuid
  /// How much of the bill this line settles.
  amountMinor            BigInt  @map("amount_minor")
  withholdingTaxRateId   String? @map("withholding_tax_rate_id") @db.Uuid
  /// The rate as it was when the line was calculated.
  withholdingBasisPoints Int?    @map("withholding_basis_points")
  /// The VAT-exclusive part of the amount, on which tax is withheld.
  withholdingBaseMinor   BigInt  @default(0) @map("withholding_base_minor")
  withheldMinor          BigInt  @default(0) @map("withheld_minor")
  cashMinor              BigInt  @map("cash_minor")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment            ErpApPayment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill               ErpApBill              @relation(fields: [billId], references: [id], onDelete: Restrict)
  withholdingTaxRate ErpWithholdingTaxRate? @relation(fields: [withholdingTaxRateId], references: [id], onDelete: Restrict)

  @@unique([paymentId, lineNo])
  @@unique([paymentId, billId])
  @@index([billId])
  @@index([withholdingTaxRateId])
  @@map("ap_payment_lines")
  @@schema("erp")
}
